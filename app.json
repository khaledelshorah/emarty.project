{
  "expo": {
    "name": "Emaraty App",
    "slug": "emaraty-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "emaraty",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emaraty.app"
    },
    "android": {
      "package": "com.emaraty.app"
    }
  }
}
